<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Fennec" Manufacturer="Ryan Fitzpatrick" Version="1.0.0" UpgradeCode="497378F4-364C-48D9-B7BE-3ECE42F247C7" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Fennec is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Fennec">
          <Component Id="ApplicationFiles" Guid="*">
            <Files Include="$(PublishDir)**" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="FennecShortcut" Name="Fennec" Target="[INSTALLFOLDER]Fennec.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveFennecMenu" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Fennec" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="Fennec" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>
</Wix>
