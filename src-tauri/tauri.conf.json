{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fennec Companion",
  "version": "0.2.0",
  "identifier": "gg.fennec.companion",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["fennec"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/ryanf9802/Fennec/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NUQ3NTk4RTY4ODlENjIKUldSaW5Zam1tSFZkNWp5TjR2T0s2dTBJUXBqbndnUENScGZjSFY1RTR0RFhQUWIvbmFVSFFHR0wK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
