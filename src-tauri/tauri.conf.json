{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fennec Companion",
  "version": "0.2.0",
  "identifier": "gg.fennec.companion",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../public/icons/icon-192.png", "../public/icons/icon-512.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["fennec"]
      }
    }
  }
}
