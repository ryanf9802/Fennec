<Application
    x:Class="Fennec.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="FennecNavyBrush" Color="#0B111D" />
                    <SolidColorBrush x:Key="FennecSurfaceBrush" Color="#131C2A" />
                    <SolidColorBrush x:Key="FennecSurfaceAltBrush" Color="#182435" />
                    <SolidColorBrush x:Key="FennecBorderBrush" Color="#2A394D" />
                    <SolidColorBrush x:Key="FennecCyanBrush" Color="#65D9EE" />
                    <SolidColorBrush x:Key="FennecOrangeBrush" Color="#FF8A3D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FennecNavyBrush" Color="#F4F7FA" />
                    <SolidColorBrush x:Key="FennecSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FennecSurfaceAltBrush" Color="#E8EFF5" />
                    <SolidColorBrush x:Key="FennecBorderBrush" Color="#CDD9E4" />
                    <SolidColorBrush x:Key="FennecCyanBrush" Color="#087E90" />
                    <SolidColorBrush x:Key="FennecOrangeBrush" Color="#C6530B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MetricLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.58" />
                <Setter Property="CharacterSpacing" Value="40" />
            </Style>
            <Style x:Key="SecondaryMetricLabel" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.58" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="FennecCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource FennecSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource FennecBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="FennecCompactCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource FennecSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource FennecBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
