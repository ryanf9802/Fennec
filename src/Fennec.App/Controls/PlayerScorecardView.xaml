<UserControl
    x:Class="Fennec.App.Controls.PlayerScorecardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource FennecCompactCard}">
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Row.Name, ElementName=Root}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Row.Score, ElementName=Root}" FontWeight="SemiBold" />
                    <TextBlock Text="PTS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Row.Encounter, ElementName=Root}" Opacity="0.58" TextWrapping="Wrap" />
            <Grid x:Name="StatGrid" ColumnSpacing="14" RowSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    <ColumnDefinition x:Name="StatColumn3" Width="0" /><ColumnDefinition x:Name="StatColumn4" Width="0" /><ColumnDefinition x:Name="StatColumn5" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <StackPanel x:Name="GoalsStat"><TextBlock Text="GOALS" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Row.Goals, ElementName=Root}" FontWeight="SemiBold"/></StackPanel>
                <StackPanel x:Name="AssistsStat" Grid.Column="1"><TextBlock Text="ASSISTS" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Row.Assists, ElementName=Root}" FontWeight="SemiBold"/></StackPanel>
                <StackPanel x:Name="SavesStat" Grid.Column="2"><TextBlock Text="SAVES" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Row.Saves, ElementName=Root}" FontWeight="SemiBold"/></StackPanel>
                <StackPanel x:Name="ShotsStat" Grid.Row="1"><TextBlock Text="SHOTS" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Row.Shots, ElementName=Root}" FontWeight="SemiBold"/></StackPanel>
                <StackPanel x:Name="TouchesStat" Grid.Row="1" Grid.Column="1"><TextBlock Text="TOUCHES" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Row.Touches, ElementName=Root}" FontWeight="SemiBold"/></StackPanel>
                <StackPanel x:Name="DemosStat" Grid.Row="1" Grid.Column="2"><TextBlock Text="DEMOS" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Row.Demos, ElementName=Root}" FontWeight="SemiBold"/></StackPanel>
            </Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact" />
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="StatColumn3.Width" Value="*" /><Setter Target="StatColumn4.Width" Value="*" /><Setter Target="StatColumn5.Width" Value="*" />
                            <Setter Target="ShotsStat.(Grid.Row)" Value="0" /><Setter Target="ShotsStat.(Grid.Column)" Value="3" />
                            <Setter Target="TouchesStat.(Grid.Row)" Value="0" /><Setter Target="TouchesStat.(Grid.Column)" Value="4" />
                            <Setter Target="DemosStat.(Grid.Row)" Value="0" /><Setter Target="DemosStat.(Grid.Column)" Value="5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </StackPanel>
    </Border>
</UserControl>
