<UserControl
    x:Class="Fennec.App.Controls.ResponsivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageContainer" Padding="16,20,16,40">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow" />
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageContainer.Padding" Value="32,28,32,48" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Medium">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageContainer.Padding" Value="24,24,24,44" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter Content="{x:Bind PageContent, Mode=OneWay}"
                              MaxWidth="{x:Bind ContentMaxWidth, Mode=OneWay}"
                              HorizontalAlignment="Stretch" />
        </Grid>
    </ScrollViewer>
</UserControl>
