<UserControl
    x:Class="Fennec.App.Controls.SessionMetricsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <Grid x:Name="PrimaryMetrics" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PrimaryColumn0" /><ColumnDefinition x:Name="PrimaryColumn1" />
                <ColumnDefinition x:Name="PrimaryColumn2" Width="0" /><ColumnDefinition x:Name="PrimaryColumn3" Width="0" />
                <ColumnDefinition x:Name="PrimaryColumn4" Width="0" /><ColumnDefinition x:Name="PrimaryColumn5" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <StackPanel x:Name="RecordPanel"><TextBlock Text="RECORD" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="RecordText" Style="{StaticResource MetricValue}"/></StackPanel>
            <StackPanel x:Name="WinRatePanel" Grid.Column="1"><TextBlock Text="WIN RATE" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="WinRateText" Style="{StaticResource MetricValue}"/></StackPanel>
            <StackPanel x:Name="StreakPanel" Grid.Row="1"><TextBlock Text="STREAK" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="StreakText" Style="{StaticResource MetricValue}"/></StackPanel>
            <StackPanel x:Name="GoalsForAgainstPanel" Grid.Row="1" Grid.Column="1"><TextBlock Text="GOALS F–A" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="GoalsForAgainstText" Style="{StaticResource MetricValue}"/></StackPanel>
            <StackPanel x:Name="GoalDiffPanel" Grid.Row="2"><TextBlock Text="GOAL DIFF" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="GoalDiffText" Style="{StaticResource MetricValue}"/></StackPanel>
            <StackPanel x:Name="ShootingPanel" Grid.Row="2" Grid.Column="1"><TextBlock Text="SHOOTING" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="ShootingText" Style="{StaticResource MetricValue}"/></StackPanel>
        </Grid>
        <Grid x:Name="SecondaryMetrics" ColumnSpacing="14" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SecondaryColumn0" /><ColumnDefinition x:Name="SecondaryColumn1" />
                <ColumnDefinition x:Name="SecondaryColumn2" Width="0" /><ColumnDefinition x:Name="SecondaryColumn3" Width="0" />
                <ColumnDefinition x:Name="SecondaryColumn4" Width="0" /><ColumnDefinition x:Name="SecondaryColumn5" Width="0" />
                <ColumnDefinition x:Name="SecondaryColumn6" Width="0" /><ColumnDefinition x:Name="SecondaryColumn7" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <StackPanel x:Name="GoalsPanel"><TextBlock Text="Goals" Style="{StaticResource SecondaryMetricLabel}"/><TextBlock x:Name="GoalsText" FontWeight="SemiBold"/></StackPanel>
            <StackPanel x:Name="AssistsPanel" Grid.Column="1"><TextBlock Text="Assists" Style="{StaticResource SecondaryMetricLabel}"/><TextBlock x:Name="AssistsText" FontWeight="SemiBold"/></StackPanel>
            <StackPanel x:Name="SavesPanel" Grid.Row="1"><TextBlock Text="Saves" Style="{StaticResource SecondaryMetricLabel}"/><TextBlock x:Name="SavesText" FontWeight="SemiBold"/></StackPanel>
            <StackPanel x:Name="ShotsPanel" Grid.Row="1" Grid.Column="1"><TextBlock Text="Shots" Style="{StaticResource SecondaryMetricLabel}"/><TextBlock x:Name="ShotsText" FontWeight="SemiBold"/></StackPanel>
            <StackPanel x:Name="ScorePanel" Grid.Row="2"><TextBlock Text="Avg score" Style="{StaticResource SecondaryMetricLabel}"/><TextBlock x:Name="ScoreText" FontWeight="SemiBold"/></StackPanel>
            <StackPanel x:Name="DemosPanel" Grid.Row="2" Grid.Column="1"><TextBlock Text="Demos" Style="{StaticResource SecondaryMetricLabel}"/><TextBlock x:Name="DemosText" FontWeight="SemiBold"/></StackPanel>
            <StackPanel x:Name="TouchesPanel" Grid.Row="3"><TextBlock Text="Touches" Style="{StaticResource SecondaryMetricLabel}"/><TextBlock x:Name="TouchesText" FontWeight="SemiBold"/></StackPanel>
            <StackPanel x:Name="GamesPanel" Grid.Row="3" Grid.Column="1"><TextBlock Text="Games" Style="{StaticResource SecondaryMetricLabel}"/><TextBlock x:Name="GamesText" FontWeight="SemiBold"/></StackPanel>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow" />
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrimaryColumn2.Width" Value="*" /><Setter Target="PrimaryColumn3.Width" Value="*" /><Setter Target="PrimaryColumn4.Width" Value="*" /><Setter Target="PrimaryColumn5.Width" Value="*" />
                        <Setter Target="StreakPanel.(Grid.Row)" Value="0" /><Setter Target="StreakPanel.(Grid.Column)" Value="2" />
                        <Setter Target="GoalsForAgainstPanel.(Grid.Row)" Value="0" /><Setter Target="GoalsForAgainstPanel.(Grid.Column)" Value="3" />
                        <Setter Target="GoalDiffPanel.(Grid.Row)" Value="0" /><Setter Target="GoalDiffPanel.(Grid.Column)" Value="4" />
                        <Setter Target="ShootingPanel.(Grid.Row)" Value="0" /><Setter Target="ShootingPanel.(Grid.Column)" Value="5" />
                        <Setter Target="SecondaryColumn2.Width" Value="*" /><Setter Target="SecondaryColumn3.Width" Value="*" /><Setter Target="SecondaryColumn4.Width" Value="*" /><Setter Target="SecondaryColumn5.Width" Value="*" /><Setter Target="SecondaryColumn6.Width" Value="*" /><Setter Target="SecondaryColumn7.Width" Value="*" />
                        <Setter Target="SavesPanel.(Grid.Row)" Value="0" /><Setter Target="SavesPanel.(Grid.Column)" Value="2" />
                        <Setter Target="ShotsPanel.(Grid.Row)" Value="0" /><Setter Target="ShotsPanel.(Grid.Column)" Value="3" />
                        <Setter Target="ScorePanel.(Grid.Row)" Value="0" /><Setter Target="ScorePanel.(Grid.Column)" Value="4" />
                        <Setter Target="DemosPanel.(Grid.Row)" Value="0" /><Setter Target="DemosPanel.(Grid.Column)" Value="5" />
                        <Setter Target="TouchesPanel.(Grid.Row)" Value="0" /><Setter Target="TouchesPanel.(Grid.Column)" Value="6" />
                        <Setter Target="GamesPanel.(Grid.Row)" Value="0" /><Setter Target="GamesPanel.(Grid.Column)" Value="7" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrimaryColumn2.Width" Value="*" />
                        <Setter Target="StreakPanel.(Grid.Row)" Value="0" /><Setter Target="StreakPanel.(Grid.Column)" Value="2" />
                        <Setter Target="GoalsForAgainstPanel.(Grid.Row)" Value="1" /><Setter Target="GoalsForAgainstPanel.(Grid.Column)" Value="0" />
                        <Setter Target="GoalDiffPanel.(Grid.Row)" Value="1" /><Setter Target="GoalDiffPanel.(Grid.Column)" Value="1" />
                        <Setter Target="ShootingPanel.(Grid.Row)" Value="1" /><Setter Target="ShootingPanel.(Grid.Column)" Value="2" />
                        <Setter Target="SecondaryColumn2.Width" Value="*" /><Setter Target="SecondaryColumn3.Width" Value="*" />
                        <Setter Target="SavesPanel.(Grid.Row)" Value="0" /><Setter Target="SavesPanel.(Grid.Column)" Value="2" />
                        <Setter Target="ShotsPanel.(Grid.Row)" Value="0" /><Setter Target="ShotsPanel.(Grid.Column)" Value="3" />
                        <Setter Target="ScorePanel.(Grid.Row)" Value="1" /><Setter Target="ScorePanel.(Grid.Column)" Value="0" />
                        <Setter Target="DemosPanel.(Grid.Row)" Value="1" /><Setter Target="DemosPanel.(Grid.Column)" Value="1" />
                        <Setter Target="TouchesPanel.(Grid.Row)" Value="1" /><Setter Target="TouchesPanel.(Grid.Column)" Value="2" />
                        <Setter Target="GamesPanel.(Grid.Row)" Value="1" /><Setter Target="GamesPanel.(Grid.Column)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </StackPanel>
</UserControl>
