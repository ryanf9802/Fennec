<Window
    x:Class="Fennec.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fennec">
    <Grid x:Name="RootLayout" Background="{ThemeResource FennecNavyBrush}">
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" PaneDisplayMode="Auto"
                        OpenPaneLength="224" CompactPaneLength="48"
                        CompactModeThresholdWidth="720" ExpandedModeThresholdWidth="1100"
                        AlwaysShowHeader="True" Background="{ThemeResource FennecNavyBrush}"
                        ItemInvoked="Navigation_ItemInvoked">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Height="40"
                            VerticalAlignment="Center">
                    <Image Width="28" Height="28" Source="Assets/fennec-mark.svg"
                           AutomationProperties.Name="Fennec logo" />
                    <TextBlock Text="Fennec" FontFamily="Segoe UI Variable Display"
                               FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.Header>
                <Grid Height="40">
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="{ThemeResource FennecSurfaceBrush}"
                            BorderBrush="{ThemeResource FennecBorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="10,5" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="Gray" />
                            <TextBlock x:Name="ConnectionLabel" Text="Starting" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Games" Tag="games" IsSelected="True">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profile" Tag="profile">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ContentControl x:Name="PageHost" />
        </NavigationView>
    </Grid>
</Window>
