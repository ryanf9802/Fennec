<UserControl
    x:Class="Fennec.App.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fennec.App.Controls">
    <controls:ResponsivePage ContentMaxWidth="1180">
        <StackPanel Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitleText" Text="Games" Style="{StaticResource PageTitle}" FontSize="28" />
                <TextBlock Text="Every match, organized automatically." Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>

            <Border x:Name="CurrentSessionPanel" Style="{StaticResource FennecCard}"
                    BorderBrush="{ThemeResource FennecCyanBrush}">
                <StackPanel Spacing="18">
                    <Grid x:Name="SessionHeader" ColumnSpacing="12" RowSpacing="5">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition x:Name="SessionRangeColumn" Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Ellipse Width="9" Height="9" Fill="{ThemeResource FennecCyanBrush}" />
                            <TextBlock Text="CURRENT SESSION" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" />
                        </StackPanel>
                        <TextBlock x:Name="SessionRange" Grid.Row="1" Opacity="0.58" TextWrapping="Wrap" />
                    </Grid>
                    <controls:SessionMetricsView x:Name="CurrentMetrics" />
                </StackPanel>
            </Border>

            <Button x:Name="LiveButton" Click="LiveButton_Click" Visibility="Collapsed"
                    HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0">
                <Border x:Name="LiveCard" Style="{StaticResource FennecCard}"
                        BorderBrush="{ThemeResource FennecOrangeBrush}" BorderThickness="2">
                    <Grid x:Name="LiveLayout" ColumnSpacing="14" RowSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition x:Name="LiveThirdColumn" Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Border Background="{ThemeResource FennecOrangeBrush}" CornerRadius="5" Padding="9,4" VerticalAlignment="Center">
                            <TextBlock Text="LIVE" Foreground="#111111" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock x:Name="LiveScore" Grid.Column="1" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="LivePlaylist" Grid.Row="1" Grid.ColumnSpan="2" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LivePersonal" Grid.Row="2" Opacity="0.65" TextWrapping="Wrap" />
                        <TextBlock x:Name="LiveClock" Grid.Row="2" Grid.Column="1" Opacity="0.65" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </Button>

            <StackPanel Spacing="12">
                <Grid x:Name="FilterGrid" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition x:Name="FilterColumn1" Width="0" />
                        <ColumnDefinition x:Name="FilterColumn2" Width="0" /><ColumnDefinition x:Name="FilterColumn3" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBox x:Name="HistorySearch" PlaceholderText="Search games or players" TextChanged="HistorySearch_TextChanged" MinHeight="40" />
                    <ComboBox x:Name="PlaylistFilter" Grid.Row="1" PlaceholderText="All playlists" SelectionChanged="HistoryFilter_Changed" MinHeight="40" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="ResultFilter" Grid.Row="2" SelectedIndex="0" SelectionChanged="HistoryFilter_Changed" MinHeight="40" HorizontalAlignment="Stretch">
                        <x:String>All results</x:String><x:String>Wins</x:String><x:String>Losses</x:String><x:String>Incomplete</x:String>
                    </ComboBox>
                    <ComboBox x:Name="DateFilter" Grid.Row="3" SelectedIndex="0" SelectionChanged="HistoryFilter_Changed" MinHeight="40" HorizontalAlignment="Stretch">
                        <x:String>All time</x:String><x:String>Last 7 days</x:String><x:String>Last 30 days</x:String><x:String>Last 90 days</x:String>
                    </ComboBox>
                </Grid>
                <TextBlock Text="GAME TIMELINE" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Opacity="0.7" />
                <ItemsControl x:Name="SessionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="8" Margin="0,4,0,20">
                                <Button Tag="{Binding Id}" Click="SessionButton_Click" HorizontalContentAlignment="Stretch"
                                        Padding="0" Background="Transparent" BorderThickness="0">
                                    <Grid Padding="4,10" ColumnSpacing="12" RowSpacing="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Text="{Binding Range}" Opacity="0.58" />
                                        <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                </Button>
                                <ItemsControl ItemsSource="{Binding Matches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Id}" Click="MatchButton_Click" HorizontalContentAlignment="Stretch"
                                                    Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0">
                                                <controls:MatchRowView Row="{Binding}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyHistory" Text="Your games will appear here as soon as Fennec receives a match."
                           Opacity="0.58" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,32" />
            </StackPanel>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow" />
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageTitleText.FontSize" Value="32" />
                            <Setter Target="SessionRangeColumn.Width" Value="Auto" />
                            <Setter Target="SessionRange.(Grid.Row)" Value="0" /><Setter Target="SessionRange.(Grid.Column)" Value="1" /><Setter Target="SessionRange.HorizontalAlignment" Value="Right" />
                            <Setter Target="LiveThirdColumn.Width" Value="Auto" />
                            <Setter Target="LivePlaylist.(Grid.Row)" Value="0" /><Setter Target="LivePlaylist.(Grid.Column)" Value="1" /><Setter Target="LivePlaylist.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="LiveScore.(Grid.Column)" Value="2" />
                            <Setter Target="LivePersonal.(Grid.Row)" Value="1" /><Setter Target="LivePersonal.(Grid.Column)" Value="1" />
                            <Setter Target="LiveClock.(Grid.Row)" Value="1" /><Setter Target="LiveClock.(Grid.Column)" Value="2" />
                            <Setter Target="FilterColumn1.Width" Value="180" /><Setter Target="FilterColumn2.Width" Value="140" /><Setter Target="FilterColumn3.Width" Value="150" />
                            <Setter Target="PlaylistFilter.(Grid.Row)" Value="0" /><Setter Target="PlaylistFilter.(Grid.Column)" Value="1" />
                            <Setter Target="ResultFilter.(Grid.Row)" Value="0" /><Setter Target="ResultFilter.(Grid.Column)" Value="2" />
                            <Setter Target="DateFilter.(Grid.Row)" Value="0" /><Setter Target="DateFilter.(Grid.Column)" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Medium">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageTitleText.FontSize" Value="32" />
                            <Setter Target="SessionRangeColumn.Width" Value="Auto" />
                            <Setter Target="SessionRange.(Grid.Row)" Value="0" /><Setter Target="SessionRange.(Grid.Column)" Value="1" /><Setter Target="SessionRange.HorizontalAlignment" Value="Right" />
                            <Setter Target="LiveThirdColumn.Width" Value="Auto" />
                            <Setter Target="LivePlaylist.(Grid.Row)" Value="0" /><Setter Target="LivePlaylist.(Grid.Column)" Value="1" /><Setter Target="LivePlaylist.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="LiveScore.(Grid.Column)" Value="2" />
                            <Setter Target="LivePersonal.(Grid.Row)" Value="1" /><Setter Target="LivePersonal.(Grid.Column)" Value="1" />
                            <Setter Target="LiveClock.(Grid.Row)" Value="1" /><Setter Target="LiveClock.(Grid.Column)" Value="2" />
                            <Setter Target="FilterColumn1.Width" Value="*" />
                            <Setter Target="PlaylistFilter.(Grid.Row)" Value="0" /><Setter Target="PlaylistFilter.(Grid.Column)" Value="1" />
                            <Setter Target="ResultFilter.(Grid.Row)" Value="1" /><Setter Target="ResultFilter.(Grid.Column)" Value="0" />
                            <Setter Target="DateFilter.(Grid.Row)" Value="1" /><Setter Target="DateFilter.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </StackPanel>
    </controls:ResponsivePage>
</UserControl>
