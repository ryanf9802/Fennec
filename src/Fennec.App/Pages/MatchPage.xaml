<UserControl
    x:Class="Fennec.App.Pages.MatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="36,30,36,48" Spacing="24" MaxWidth="1180">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}"/><TextBlock x:Name="MatchContext" Opacity="0.6"/></StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="ScoreText" FontSize="38" FontWeight="SemiBold"/><TextBlock x:Name="ClockText" HorizontalAlignment="Right" Foreground="{StaticResource FennecOrangeBrush}"/></StackPanel>
            </Grid>
            <Grid ColumnSpacing="22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                    <TextBlock Text="SCOREBOARD" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Opacity="0.7"/>
                    <ListView x:Name="ScoreboardList" IsItemClickEnabled="True" ItemClick="ScoreboardList_ItemClick" SelectionMode="None">
                        <ListView.Header>
                            <Grid Padding="14,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/><ColumnDefinition Width="35"/><ColumnDefinition Width="35"/><ColumnDefinition Width="35"/><ColumnDefinition Width="35"/><ColumnDefinition Width="45"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <TextBlock Text="PLAYER" Opacity="0.5" FontSize="11"/><TextBlock Grid.Column="1" Text="PTS" Opacity="0.5" FontSize="11"/>
                                <TextBlock Grid.Column="2" Text="G" Opacity="0.5"/><TextBlock Grid.Column="3" Text="A" Opacity="0.5"/><TextBlock Grid.Column="4" Text="SV" Opacity="0.5"/><TextBlock Grid.Column="5" Text="SH" Opacity="0.5"/><TextBlock Grid.Column="6" Text="TCH" Opacity="0.5"/><TextBlock Grid.Column="7" Text="DM" Opacity="0.5"/>
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate><DataTemplate><Grid Padding="14,10" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/><ColumnDefinition Width="35"/><ColumnDefinition Width="35"/><ColumnDefinition Width="35"/><ColumnDefinition Width="35"/><ColumnDefinition Width="45"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Encounter}" Opacity="0.5" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Score}"/><TextBlock Grid.Column="2" Text="{Binding Goals}"/><TextBlock Grid.Column="3" Text="{Binding Assists}"/><TextBlock Grid.Column="4" Text="{Binding Saves}"/><TextBlock Grid.Column="5" Text="{Binding Shots}"/><TextBlock Grid.Column="6" Text="{Binding Touches}"/><TextBlock Grid.Column="7" Text="{Binding Demos}"/>
                        </Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10">
                    <Grid><TextBlock Text="EVENT TIMELINE" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Opacity="0.7"/><TextBlock x:Name="PresetLabel" HorizontalAlignment="Right" Opacity="0.55"/></Grid>
                    <ListView x:Name="TimelineList" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate><Grid Padding="10,9" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Clock}" Foreground="{StaticResource FennecCyanBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" Opacity="0.55" TextWrapping="Wrap"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
