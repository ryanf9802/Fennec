<UserControl
    x:Class="Fennec.App.Pages.MatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fennec.App.Controls">
    <controls:ResponsivePage ContentMaxWidth="1180">
        <StackPanel Spacing="24">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" FontSize="28" />
                    <TextBlock x:Name="MatchContext" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock x:Name="ScoreText" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ClockText" HorizontalAlignment="Right" Foreground="{ThemeResource FennecOrangeBrush}" />
                </StackPanel>
            </Grid>
            <Grid x:Name="MatchLayout" ColumnSpacing="22" RowSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ScoreboardColumn" /><ColumnDefinition x:Name="TimelineColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <StackPanel Spacing="10">
                    <TextBlock Text="SCOREBOARD" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Opacity="0.7" />
                    <ListView x:Name="ScoreboardList" IsItemClickEnabled="True" ItemClick="ScoreboardList_ItemClick"
                              SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate><controls:PlayerScorecardView Row="{Binding}" /></DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <StackPanel x:Name="TimelinePanel" Grid.Row="1" Spacing="10">
                    <Grid ColumnSpacing="12">
                        <TextBlock Text="EVENT TIMELINE" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Opacity="0.7" />
                        <TextBlock x:Name="PresetLabel" HorizontalAlignment="Right" Opacity="0.58" />
                    </Grid>
                    <ListView x:Name="TimelineList" SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FennecCompactCard}" Margin="0,0,0,4">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Clock}" Foreground="{ThemeResource FennecCyanBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Details}" Opacity="0.58" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Stacked" />
                    <VisualState x:Name="SideBySide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageTitleText.FontSize" Value="32" />
                            <Setter Target="TimelineColumn.Width" Value="2*" />
                            <Setter Target="ScoreboardColumn.Width" Value="3*" />
                            <Setter Target="TimelinePanel.(Grid.Row)" Value="0" /><Setter Target="TimelinePanel.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Comfortable">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageTitleText.FontSize" Value="32" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </StackPanel>
    </controls:ResponsivePage>
</UserControl>
