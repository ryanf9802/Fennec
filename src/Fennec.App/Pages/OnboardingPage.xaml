<UserControl x:Class="Fennec.App.Pages.OnboardingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="48" Spacing="26" MaxWidth="760" HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" Spacing="12"><Image Source="/Assets/fennec-mark.svg" Width="84" Height="84"/><TextBlock Text="Welcome to Fennec" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/><TextBlock Text="A local second-monitor dashboard for every Rocket League match." Opacity="0.65" HorizontalAlignment="Center"/></StackPanel>
        <Border Background="{StaticResource FennecSurfaceBrush}" CornerRadius="12" Padding="22"><StackPanel Spacing="14">
            <TextBlock Text="1 · Enable the Stats API" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose a detected configuration below, configure automatically, or copy the manual settings. Rocket League must be restarted after a change." TextWrapping="Wrap" Opacity="0.7"/>
            <ComboBox x:Name="ConfigPicker" HorizontalAlignment="Stretch"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Configure automatically" Click="Configure_Click"/><Button Content="Show manual setup" Click="Manual_Click"/></StackPanel>
            <InfoBar x:Name="SetupStatus" IsOpen="False" IsClosable="True"/>
        </StackPanel></Border>
        <Border Background="{StaticResource FennecSurfaceBrush}" CornerRadius="12" Padding="22"><StackPanel Spacing="8"><TextBlock Text="2 · Choose yourself after a roster appears" Style="{StaticResource SectionTitle}"/><TextBlock Text="Fennec records safely before you choose. Open Profile after joining a match and select your player once." TextWrapping="Wrap" Opacity="0.7"/></StackPanel></Border>
        <Button Content="Start monitoring" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="Continue_Click"/>
    </StackPanel></ScrollViewer>
</UserControl>
