<UserControl
    x:Class="Fennec.App.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fennec.App.Controls">
    <controls:ResponsivePage ContentMaxWidth="760">
        <StackPanel Spacing="24">
            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <Image Source="/Assets/fennec-mark.svg" Width="76" Height="76" />
                <TextBlock x:Name="WelcomeTitle" Text="Welcome to Fennec" Style="{StaticResource PageTitle}"
                           FontSize="28" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="A local second-monitor dashboard for every Rocket League match."
                           Opacity="0.65" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <Border Style="{StaticResource FennecCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="1 · Enable the Stats API" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Choose a detected configuration below, configure automatically, or copy the manual settings. Rocket League must be restarted after a change."
                               TextWrapping="Wrap" Opacity="0.7" />
                    <ComboBox x:Name="ConfigPicker" HorizontalAlignment="Stretch" MinHeight="40" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SetupActionColumn0" /><ColumnDefinition x:Name="SetupActionColumn1" Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Button x:Name="AutoConfigureButton" Content="Configure automatically" Click="Configure_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                        <Button x:Name="ManualSetupButton" Grid.Row="1" Content="Show manual setup" Click="Manual_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                    </Grid>
                    <InfoBar x:Name="SetupStatus" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FennecCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="2 · Choose yourself after a roster appears" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Fennec records safely before you choose. Open Profile after joining a match and select your player once."
                               TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </Border>
            <Button x:Name="StartMonitoringButton" Content="Start monitoring" HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}" MinHeight="40" Click="Continue_Click" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow" />
                    <VisualState x:Name="Comfortable">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="WelcomeTitle.FontSize" Value="32" />
                            <Setter Target="SetupActionColumn0.Width" Value="*" /><Setter Target="SetupActionColumn1.Width" Value="*" />
                            <Setter Target="ManualSetupButton.(Grid.Row)" Value="0" /><Setter Target="ManualSetupButton.(Grid.Column)" Value="1" />
                            <Setter Target="StartMonitoringButton.HorizontalAlignment" Value="Right" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </StackPanel>
    </controls:ResponsivePage>
</UserControl>
