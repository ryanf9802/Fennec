<UserControl
    x:Class="Fennec.App.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fennec.App.Controls">
    <controls:ResponsivePage ContentMaxWidth="900">
        <StackPanel Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitleText" Text="Profile" Style="{StaticResource PageTitle}" FontSize="28" />
                <TextBlock Text="Your tracked Rocket League identity." Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>
            <Border Style="{StaticResource FennecCard}">
                <StackPanel Spacing="18">
                    <StackPanel>
                        <TextBlock Text="DISPLAY NAME" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="DisplayNameText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid x:Name="ProfileMetrics" ColumnSpacing="20" RowSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition x:Name="ProfileColumn2" Width="0" /><ColumnDefinition x:Name="ProfileColumn3" Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <StackPanel x:Name="PlatformMetric"><TextBlock Text="PLATFORM" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="PlatformText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel x:Name="GamesMetric" Grid.Column="1"><TextBlock Text="GAMES TRACKED" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="GamesText" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel x:Name="SessionsMetric" Grid.Row="1"><TextBlock Text="SESSIONS" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="SessionsText" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel x:Name="TrackingMetric" Grid.Row="1" Grid.Column="1"><TextBlock Text="TRACKING SINCE" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TrackingSinceText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                    </Grid>
                    <Expander Header="Platform identifier">
                        <TextBlock x:Name="PrimaryIdText" FontFamily="Cascadia Mono" TextWrapping="Wrap" Margin="0,10" />
                    </Expander>
                </StackPanel>
            </Border>
            <StackPanel Spacing="10">
                <TextBlock Text="SELECT YOUR PLAYER" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Fennec identifies you by the stable platform ID received in a match. Changing this recalculates summaries without deleting history."
                           Opacity="0.65" TextWrapping="Wrap" />
                <ComboBox x:Name="PlayerPicker" PlaceholderText="Play or open a match to discover players"
                          DisplayMemberPath="Name" HorizontalAlignment="Stretch" MinHeight="40" />
                <Button x:Name="SavePlayerButton" Content="Use selected player" HorizontalAlignment="Stretch" MinHeight="38" Click="SavePlayer_Click" />
                <InfoBar x:Name="ProfileStatus" IsOpen="False" IsClosable="True" />
            </StackPanel>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow" />
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageTitleText.FontSize" Value="32" />
                            <Setter Target="ProfileColumn2.Width" Value="*" /><Setter Target="ProfileColumn3.Width" Value="*" />
                            <Setter Target="SessionsMetric.(Grid.Row)" Value="0" /><Setter Target="SessionsMetric.(Grid.Column)" Value="2" />
                            <Setter Target="TrackingMetric.(Grid.Row)" Value="0" /><Setter Target="TrackingMetric.(Grid.Column)" Value="3" />
                            <Setter Target="PlayerPicker.Width" Value="520" /><Setter Target="PlayerPicker.HorizontalAlignment" Value="Left" />
                            <Setter Target="SavePlayerButton.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Comfortable">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageTitleText.FontSize" Value="32" />
                            <Setter Target="PlayerPicker.Width" Value="520" /><Setter Target="PlayerPicker.HorizontalAlignment" Value="Left" />
                            <Setter Target="SavePlayerButton.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </StackPanel>
    </controls:ResponsivePage>
</UserControl>
