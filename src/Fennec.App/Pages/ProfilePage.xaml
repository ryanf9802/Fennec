<UserControl x:Class="Fennec.App.Pages.ProfilePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="36,30,36,48" Spacing="24" MaxWidth="900">
        <StackPanel Spacing="4"><TextBlock Text="Profile" Style="{StaticResource PageTitle}"/><TextBlock Text="Your tracked Rocket League identity." Opacity="0.65"/></StackPanel>
        <Border Background="{StaticResource FennecSurfaceBrush}" CornerRadius="12" Padding="24">
            <StackPanel Spacing="18">
                <StackPanel><TextBlock Text="DISPLAY NAME" FontSize="11" Opacity="0.55"/><TextBlock x:Name="DisplayNameText" FontSize="28" FontWeight="SemiBold"/></StackPanel>
                <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="PLATFORM" FontSize="11" Opacity="0.55"/><TextBlock x:Name="PlatformText" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="GAMES TRACKED" FontSize="11" Opacity="0.55"/><TextBlock x:Name="GamesText" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="SESSIONS" FontSize="11" Opacity="0.55"/><TextBlock x:Name="SessionsText" FontWeight="SemiBold"/></StackPanel>
                </Grid>
                <StackPanel><TextBlock Text="TRACKING SINCE" FontSize="11" Opacity="0.55"/><TextBlock x:Name="TrackingSinceText" FontWeight="SemiBold"/></StackPanel>
                <Expander Header="Platform identifier"><TextBlock x:Name="PrimaryIdText" FontFamily="Cascadia Mono" TextWrapping="Wrap" Margin="0,10"/></Expander>
            </StackPanel>
        </Border>
        <StackPanel Spacing="10"><TextBlock Text="SELECT YOUR PLAYER" Style="{StaticResource SectionTitle}"/><TextBlock Text="Fennec identifies you by the stable platform ID received in a match. Changing this recalculates summaries without deleting history." Opacity="0.65" TextWrapping="Wrap"/>
            <ComboBox x:Name="PlayerPicker" PlaceholderText="Play or open a match to discover players" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
            <Button Content="Use selected player" HorizontalAlignment="Left" Click="SavePlayer_Click"/>
            <InfoBar x:Name="ProfileStatus" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </StackPanel></ScrollViewer>
</UserControl>
