<UserControl
    x:Class="Fennec.App.Pages.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fennec.App.Controls">
    <controls:ResponsivePage ContentMaxWidth="1000">
        <StackPanel Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" FontSize="28" />
                <TextBlock x:Name="RangeText" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
            <Border Style="{StaticResource FennecCard}">
                <controls:SessionMetricsView x:Name="SessionMetrics" />
            </Border>
            <StackPanel x:Name="RecurringPlayersPanel" Spacing="5">
                <TextBlock Text="FAMILIAR PLAYERS" FontSize="12" CharacterSpacing="80" FontWeight="SemiBold" Opacity="0.7" />
                <TextBlock x:Name="RecurringPlayersText" TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
            <TextBlock Text="GAMES" FontSize="12" CharacterSpacing="80" FontWeight="SemiBold" Opacity="0.7" />
            <ListView x:Name="GameList" IsItemClickEnabled="True" ItemClick="GameList_ItemClick" SelectionMode="None"
                      HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate><controls:MatchRowView Row="{Binding}" /></DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow" />
                    <VisualState x:Name="Comfortable">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="TitleText.FontSize" Value="32" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </StackPanel>
    </controls:ResponsivePage>
</UserControl>
