<UserControl x:Class="Fennec.App.Pages.SessionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="36,30,36,48" Spacing="24" MaxWidth="1000">
        <StackPanel><TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"/><TextBlock x:Name="RangeText" Opacity="0.6"/></StackPanel>
        <Border Background="{StaticResource FennecSurfaceBrush}" CornerRadius="12" Padding="22"><StackPanel Spacing="18">
            <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="RECORD" Opacity="0.5"/><TextBlock x:Name="RecordText" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="WIN RATE" Opacity="0.5"/><TextBlock x:Name="WinRateText" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="STREAK" Opacity="0.5"/><TextBlock x:Name="StreakText" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="GOALS F–A" Opacity="0.5"/><TextBlock x:Name="GoalsForAgainstText" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="GOAL DIFF" Opacity="0.5"/><TextBlock x:Name="GoalDiffText" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Grid.Column="5"><TextBlock Text="SHOOTING" Opacity="0.5"/><TextBlock x:Name="ShootingText" Style="{StaticResource MetricValue}"/></StackPanel>
            </Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Goals" Opacity="0.5"/><TextBlock x:Name="GoalsText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Assists" Opacity="0.5"/><TextBlock x:Name="AssistsText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Saves" Opacity="0.5"/><TextBlock x:Name="SavesText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="Shots" Opacity="0.5"/><TextBlock x:Name="ShotsText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Avg score" Opacity="0.5"/><TextBlock x:Name="ScoreText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="5"><TextBlock Text="Demos" Opacity="0.5"/><TextBlock x:Name="DemosText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="6"><TextBlock Text="Touches" Opacity="0.5"/><TextBlock x:Name="TouchesText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="7"><TextBlock Text="Games" Opacity="0.5"/><TextBlock x:Name="GamesText" FontWeight="SemiBold"/></StackPanel>
            </Grid>
        </StackPanel></Border>
        <StackPanel x:Name="RecurringPlayersPanel" Spacing="5"><TextBlock Text="FAMILIAR PLAYERS" FontSize="12" CharacterSpacing="80" FontWeight="SemiBold" Opacity="0.7"/><TextBlock x:Name="RecurringPlayersText" TextWrapping="Wrap" Opacity="0.7"/></StackPanel>
        <TextBlock Text="GAMES" FontSize="12" CharacterSpacing="80" FontWeight="SemiBold" Opacity="0.7"/>
        <ListView x:Name="GameList" IsItemClickEnabled="True" ItemClick="GameList_ItemClick" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="14,12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="85"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Result}" FontWeight="Bold" Foreground="{StaticResource FennecCyanBrush}"/><TextBlock Grid.Column="1" Text="{Binding Score}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Playlist}"/><TextBlock Grid.Column="3" Text="{Binding PersonalLine}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
    </StackPanel></ScrollViewer>
</UserControl>
