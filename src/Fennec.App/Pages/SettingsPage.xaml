<UserControl
    x:Class="Fennec.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fennec.App.Controls">
    <controls:ResponsivePage ContentMaxWidth="900">
        <StackPanel Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitleText" Text="Settings" Style="{StaticResource PageTitle}" FontSize="28" />
                <TextBlock Text="Monitoring, sessions, timeline, and local data." Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource FennecCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Monitoring" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="ConfigPath" Header="Rocket League Stats API configuration"
                             PlaceholderText="...\TAGame\Config\TAStatsAPI.ini" MinHeight="40" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="MonitorActionColumn0" /><ColumnDefinition x:Name="MonitorActionColumn1" Width="0" />
                            <ColumnDefinition x:Name="MonitorActionColumn2" Width="0" /><ColumnDefinition x:Name="MonitorActionColumn3" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Button x:Name="DetectButton" Content="Use detected path" Click="Detect_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                        <Button x:Name="BrowseButton" Grid.Row="1" Content="Browse…" Click="Browse_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                        <Button x:Name="ConfigureButton" Grid.Row="2" Content="Configure automatically" Click="Configure_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                        <Button x:Name="ManualButton" Grid.Row="3" Content="Manual instructions" Click="Manual_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                    </Grid>
                    <NumberBox x:Name="WebPort" Header="WebSocket port" Minimum="1024" Maximum="65535"
                               SpinButtonPlacementMode="Inline" MinHeight="40" HorizontalAlignment="Stretch" />
                    <InfoBar x:Name="SettingsStatus" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FennecCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sessions and behavior" Style="{StaticResource SectionTitle}" />
                    <NumberBox x:Name="SessionGap" Header="New session after this many idle minutes" Minimum="1" Maximum="240"
                               SpinButtonPlacementMode="Inline" MinHeight="40" HorizontalAlignment="Stretch" />
                    <ToggleSwitch x:Name="AutoOpen" Header="Automatically open the live monitor" />
                    <ToggleSwitch x:Name="StartWithWindows" Header="Start Fennec with Windows" />
                    <ComboBox x:Name="ThemePicker" Header="Appearance" HorizontalAlignment="Stretch" MinHeight="40">
                        <x:String>Dark</x:String><x:String>System</x:String><x:String>Light</x:String>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FennecCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Timeline" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Curated is a calm baseline. Everything displays every stored discrete event and attribute. Custom lets you choose both."
                               TextWrapping="Wrap" Opacity="0.65" />
                    <ComboBox x:Name="TimelinePresetPicker" Header="Default preset" HorizontalAlignment="Stretch" MinHeight="40"
                              SelectionChanged="TimelinePreset_Changed">
                        <x:String>Curated</x:String><x:String>Everything</x:String><x:String>Custom</x:String>
                    </ComboBox>
                    <StackPanel x:Name="TimelineEventOptions" Spacing="6" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FennecCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Local data" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="History stays on this PC until you delete it." Opacity="0.65" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="DataActionColumn0" /><ColumnDefinition x:Name="DataActionColumn1" Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Button x:Name="ExportButton" Content="Export JSON + CSV" Click="Export_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                        <Button x:Name="DeleteButton" Grid.Row="1" Content="Delete match history" Click="Delete_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="DiagnosticsPanel" Style="{StaticResource FennecCard}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Text="Developer diagnostics" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Developer mode records connection and lifecycle details without raw Stats API payloads or player names."
                               TextWrapping="Wrap" Opacity="0.65" />
                    <Border Background="{ThemeResource FennecSurfaceAltBrush}" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="7">
                            <TextBlock x:Name="DiagnosticVersion" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DiagnosticConnection" TextWrapping="Wrap" />
                            <TextBlock x:Name="DiagnosticEndpoint" FontFamily="Cascadia Mono" TextWrapping="Wrap" />
                            <TextBlock x:Name="DiagnosticLastEntry" TextWrapping="Wrap" Opacity="0.65" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DiagnosticActionColumn0" /><ColumnDefinition x:Name="DiagnosticActionColumn1" Width="0" /><ColumnDefinition x:Name="DiagnosticActionColumn2" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Button x:Name="CopyDiagnosticsButton" Content="Copy diagnostics" Click="CopyDiagnostics_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                        <Button x:Name="OpenLogsButton" Grid.Row="1" Content="Open logs" Click="OpenLogs_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                        <Button x:Name="OpenDataButton" Grid.Row="2" Content="Open data folder" Click="OpenData_Click" HorizontalAlignment="Stretch" MinHeight="38" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="SaveSettingsButton" Content="Save settings" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" MinHeight="40" Click="Save_Click" />

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow" />
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageTitleText.FontSize" Value="32" />
                            <Setter Target="MonitorActionColumn0.Width" Value="Auto" /><Setter Target="MonitorActionColumn1.Width" Value="Auto" /><Setter Target="MonitorActionColumn2.Width" Value="Auto" /><Setter Target="MonitorActionColumn3.Width" Value="Auto" />
                            <Setter Target="BrowseButton.(Grid.Row)" Value="0" /><Setter Target="BrowseButton.(Grid.Column)" Value="1" />
                            <Setter Target="ConfigureButton.(Grid.Row)" Value="0" /><Setter Target="ConfigureButton.(Grid.Column)" Value="2" />
                            <Setter Target="ManualButton.(Grid.Row)" Value="0" /><Setter Target="ManualButton.(Grid.Column)" Value="3" />
                            <Setter Target="WebPort.Width" Value="520" /><Setter Target="WebPort.HorizontalAlignment" Value="Left" />
                            <Setter Target="SessionGap.Width" Value="520" /><Setter Target="SessionGap.HorizontalAlignment" Value="Left" />
                            <Setter Target="ThemePicker.Width" Value="520" /><Setter Target="ThemePicker.HorizontalAlignment" Value="Left" />
                            <Setter Target="TimelinePresetPicker.Width" Value="520" /><Setter Target="TimelinePresetPicker.HorizontalAlignment" Value="Left" />
                            <Setter Target="TimelineEventOptions.Width" Value="520" /><Setter Target="TimelineEventOptions.HorizontalAlignment" Value="Left" />
                            <Setter Target="DataActionColumn0.Width" Value="Auto" /><Setter Target="DataActionColumn1.Width" Value="Auto" />
                            <Setter Target="DeleteButton.(Grid.Row)" Value="0" /><Setter Target="DeleteButton.(Grid.Column)" Value="1" />
                            <Setter Target="DiagnosticActionColumn0.Width" Value="Auto" /><Setter Target="DiagnosticActionColumn1.Width" Value="Auto" /><Setter Target="DiagnosticActionColumn2.Width" Value="Auto" />
                            <Setter Target="OpenLogsButton.(Grid.Row)" Value="0" /><Setter Target="OpenLogsButton.(Grid.Column)" Value="1" />
                            <Setter Target="OpenDataButton.(Grid.Row)" Value="0" /><Setter Target="OpenDataButton.(Grid.Column)" Value="2" />
                            <Setter Target="SaveSettingsButton.HorizontalAlignment" Value="Right" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Medium">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageTitleText.FontSize" Value="32" />
                            <Setter Target="MonitorActionColumn1.Width" Value="*" />
                            <Setter Target="BrowseButton.(Grid.Row)" Value="0" /><Setter Target="BrowseButton.(Grid.Column)" Value="1" />
                            <Setter Target="ConfigureButton.(Grid.Row)" Value="1" /><Setter Target="ConfigureButton.(Grid.Column)" Value="0" />
                            <Setter Target="ManualButton.(Grid.Row)" Value="1" /><Setter Target="ManualButton.(Grid.Column)" Value="1" />
                            <Setter Target="WebPort.Width" Value="520" /><Setter Target="WebPort.HorizontalAlignment" Value="Left" />
                            <Setter Target="SessionGap.Width" Value="520" /><Setter Target="SessionGap.HorizontalAlignment" Value="Left" />
                            <Setter Target="ThemePicker.Width" Value="520" /><Setter Target="ThemePicker.HorizontalAlignment" Value="Left" />
                            <Setter Target="TimelinePresetPicker.Width" Value="520" /><Setter Target="TimelinePresetPicker.HorizontalAlignment" Value="Left" />
                            <Setter Target="TimelineEventOptions.Width" Value="520" /><Setter Target="TimelineEventOptions.HorizontalAlignment" Value="Left" />
                            <Setter Target="DataActionColumn0.Width" Value="*" /><Setter Target="DataActionColumn1.Width" Value="*" />
                            <Setter Target="DeleteButton.(Grid.Row)" Value="0" /><Setter Target="DeleteButton.(Grid.Column)" Value="1" />
                            <Setter Target="DiagnosticActionColumn0.Width" Value="Auto" /><Setter Target="DiagnosticActionColumn1.Width" Value="Auto" /><Setter Target="DiagnosticActionColumn2.Width" Value="Auto" />
                            <Setter Target="OpenLogsButton.(Grid.Row)" Value="0" /><Setter Target="OpenLogsButton.(Grid.Column)" Value="1" />
                            <Setter Target="OpenDataButton.(Grid.Row)" Value="0" /><Setter Target="OpenDataButton.(Grid.Column)" Value="2" />
                            <Setter Target="SaveSettingsButton.HorizontalAlignment" Value="Right" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </StackPanel>
    </controls:ResponsivePage>
</UserControl>
