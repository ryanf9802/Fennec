<UserControl x:Class="Fennec.App.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="36,30,36,48" Spacing="28" MaxWidth="900">
        <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageTitle}"/><TextBlock Text="Monitoring, sessions, timeline, and local data." Opacity="0.65"/></StackPanel>
        <StackPanel Spacing="12"><TextBlock Text="Monitoring" Style="{StaticResource SectionTitle}"/><TextBox x:Name="ConfigPath" Header="Rocket League Stats API configuration" PlaceholderText="...\TAGame\Config\TAStatsAPI.ini"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Use detected path" Click="Detect_Click"/><Button Content="Browse…" Click="Browse_Click"/><Button Content="Configure automatically" Click="Configure_Click"/><Button Content="Manual instructions" Click="Manual_Click"/></StackPanel><NumberBox x:Name="WebPort" Header="WebSocket port" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Inline"/><InfoBar x:Name="SettingsStatus" IsOpen="False" IsClosable="True"/></StackPanel>
        <StackPanel Spacing="12"><TextBlock Text="Sessions and behavior" Style="{StaticResource SectionTitle}"/><NumberBox x:Name="SessionGap" Header="New session after this many idle minutes" Minimum="1" Maximum="240" SpinButtonPlacementMode="Inline"/><ToggleSwitch x:Name="AutoOpen" Header="Automatically open the live monitor"/><ToggleSwitch x:Name="StartWithWindows" Header="Start Fennec with Windows"/><ComboBox x:Name="ThemePicker" Header="Appearance" Width="220" HorizontalAlignment="Left"><x:String>Dark</x:String><x:String>System</x:String><x:String>Light</x:String></ComboBox></StackPanel>
        <StackPanel Spacing="12"><TextBlock Text="Timeline" Style="{StaticResource SectionTitle}"/><TextBlock Text="Curated is a calm baseline. Everything displays every stored discrete event and attribute. Custom lets you choose both." TextWrapping="Wrap" Opacity="0.65"/><ComboBox x:Name="TimelinePresetPicker" Header="Default preset" Width="220" HorizontalAlignment="Left" SelectionChanged="TimelinePreset_Changed"><x:String>Curated</x:String><x:String>Everything</x:String><x:String>Custom</x:String></ComboBox><StackPanel x:Name="TimelineEventOptions" Spacing="6"/></StackPanel>
        <StackPanel Spacing="12"><TextBlock Text="Local data" Style="{StaticResource SectionTitle}"/><TextBlock Text="History stays on this PC until you delete it." Opacity="0.65"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Export JSON + CSV" Click="Export_Click"/><Button Content="Delete match history" Click="Delete_Click"/></StackPanel></StackPanel>
        <Button Content="Save settings" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="Save_Click"/>
    </StackPanel></ScrollViewer>
</UserControl>
